// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CrimeIncident {
  id String @id @default(cuid())

  // Blotter Information
  blotterNo   String?   @map("blotter_no") // Blotter number
  dateEncoded DateTime? @map("date_encoded") // When record was encoded

  // Police Organization Structure
  pro String? @map("police_regional_office") // Police Regional Office
  ppo String? @map("police_provincial_office") // Police Provincial Office
  stn String? @map("station") // Police Station
  pcp String? @map("police_community_precinct") // Police Community Precinct

  // Administrative Location
  region    String?
  province  String?
  municipal String? @map("municipality")
  barangay  String
  street    String?

  // Location Details
  typeOfPlace String? @map("type_of_place") // Type of place where incident occurred

  // Reporting Information
  dateReported DateTime @map("date_reported")
  timeReported String   @map("time_reported") // HH:MM:SS format

  // Incident Information
  dateCommitted DateTime @map("date_committed")
  timeCommitted String   @map("time_committed") // HH:MM:SS format
  incidentType  String   @map("incident_type") // Type of incident
  isCrime       Boolean  @default(true) @map("is_crime") // YES/NO from iscime column

  // Process Information
  modeReporting String? @map("mode_reporting") // How the crime was reported
  stageOfFelony String? @map("stage_of_felony") // Stage of the felony

  // Legal Information
  offense     String? // Legal offense description
  offenseType String? @map("offense_type") // Type of offense (Republic Act, etc.)
  section     String? // Legal section reference

  // Crime Details
  modus            String? // Method of operation
  suspectMotive    String? @map("suspect_motive") // Motive of the suspect
  suspectSubMotive String? @map("suspect_sub_motive") // Sub-motive of the suspect

  // Crime Classification
  heinous     Boolean @default(false) // Is crime heinous
  sensational Boolean @default(false) // Is crime sensational

  // Threat Group Information
  threatGrp             Boolean @default(false) @map("threat_grp") // Threat group involvement
  grpAffiliation        String? @map("grp_affiliation") // Group affiliation details
  incidentTypeThreatGrp String? @map("incident_type_threat_grp") // Incident type threat group
  mrs                   String? // MRS field

  // Suspect Information
  suspectIsEGO       Boolean  @default(false) @map("suspect_is_ego") // Is suspect elected/government official
  suspectEGOPosition String?  @map("suspect_ego_position") // Suspect's government position
  suspectEGOClass    String?  @map("suspect_ego_class") // Suspect's government class
  suspectCount       Int?     @map("suspect_count") // Number of suspects
  suspectArrested    Boolean? @map("suspect_arrested") // Was suspect arrested

  // Victim Information
  victimIsEGO       Boolean @default(false) @map("victim_is_ego") // Is victim elected/government official
  victimEGOPosition String? @map("victim_ego_position") // Victim's government position
  victimEGOClass    String? @map("victim_ego_class") // Victim's government class
  victimCount       Int?    @map("victim_count") // Number of victims

  // Case Management
  caseStatus   String? @map("case_status") // Case status (Cleared, etc.)
  investigator String? // Assigned investigator
  headInves    String? @map("head_investigator") // Head investigator

  // Geographic Coordinates
  latitude  Float? @map("lat")
  longitude Float? @map("lng")

  // System Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([barangay])
  @@index([dateCommitted])
  @@index([incidentType])
  @@index([region, province, municipal])
  @@index([latitude, longitude])
  @@index([blotterNo])
  @@index([caseStatus])
  @@index([heinous])
  @@index([sensational])
  @@map("crime_incidents")
}

model Barangay {
  id          String   @id @default(cuid())
  name        String   @unique
  coordinates Json? // Store GeoJSON coordinates if needed
  population  Int?
  area        Float? // Area in square kilometers
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("barangays")
}

model AuditLog {
  id String @id @default(cuid())

  // Generic audit fields
  action    String?  @default("Import") // e.g., "Auth", "Import", "Read", "Export", "Settings"
  details   String?
  user      String?
  createdAt DateTime @default(now()) @map("created_at")

  ip       String?
  session  String?
  resource String?
  severity String? @default("low") // "low", "medium", "high"
  outcome  String? @default("success")

  // Specific import fields
  fileName        String? @map("file_name")
  fileSize        Int?    @map("file_size") // File size in bytes
  recordsImported Int?    @map("records_imported") // Number of records imported
  errorMessage    String? @map("error_message") // Error details if failed

  notifications Notification[]

  @@index([createdAt])
  @@index([outcome])
  @@index([action])
  @@map("audit_logs")
}

// ==========================================
// NOTIFICATION & INTELLIGENCE RULE MODELS
// ==========================================

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationCategory {
  PEAK_HOUR
  CRIME_ACTIVITY
  DATASET_PROCESSING
  SYSTEM
}

enum RuleConditionType {
  HOURLY_PERCENT_EXCEEDS
  BARANGAY_INCREASE_PERCENT
  HEINOUS_CRIME_DETECTED
  SPECIFIC_CRIME_THRESHOLD
  UPLOAD_VALIDATION_ERROR_RATE
}

model Notification {
  id       String               @id @default(cuid())
  title    String
  message  String               @db.Text
  category NotificationCategory
  severity NotificationSeverity @default(INFO)

  uploadLogId String?   @map("upload_log_id")
  uploadLog   AuditLog? @relation(fields: [uploadLogId], references: [id], onDelete: Cascade)

  metadata   Json?
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at")
  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([severity])
  @@index([category])
  @@index([isRead])
  @@index([isArchived])
  @@index([uploadLogId])
  @@map("notifications")
}

model NotificationRule {
  id            String               @id @default(cuid())
  ruleKey       String               @unique @map("rule_key")
  name          String
  description   String?              @db.Text
  category      NotificationCategory
  conditionType RuleConditionType    @map("condition_type")
  parameters    Json
  severity      NotificationSeverity @default(WARNING)
  isEnabled     Boolean              @default(true) @map("is_enabled")
  updatedBy     Int?                 @map("updated_by")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@map("notification_rules")
}

// Authentication and Authorization Models

model User {
  id                 Int      @id @default(autoincrement())
  accountNumber      String   @unique @map("account_number") // Unique account number
  fullName           String   @map("full_name")
  passwordHash       String   @map("password_hash")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  permissions UserPermission[]

  @@index([accountNumber])
  @@map("users")
}

model Permission {
  id             Int     @id @default(autoincrement())
  permissionName String  @unique @map("permission_name") // e.g., "admin", "operational_officer", "privileged_user"
  description    String?

  // Relations
  users UserPermission[]

  @@map("permissions")
}

model UserPermission {
  userId       Int      @map("user_id")
  permissionId Int      @map("permission_id")
  assignedBy   Int?     @map("assigned_by") // User ID who assigned this permission
  assignedAt   DateTime @default(now()) @map("assigned_at")

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}
